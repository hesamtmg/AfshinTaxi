# Copy this file to .env and fill in real values before running:
#   docker compose up -d --build
#
# .env is read automatically by `docker compose` from the same directory
# as docker-compose.yml. Never commit the real .env file.

# ---- Domain / reverse proxy ----
# Public hostname nginx will answer on. Also used to build default URLs below.
DOMAIN=yourdomain.com

# ---- Database ----
DB_USERNAME=afshintaxi
DB_PASSWORD=change_me_to_a_strong_password
DB_NAME=afshintaxi

# ---- Backend (NestJS) ----
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# SMS provider used for OTP
SMS_API_KEY=your_sms_api_key
SMS_SENDER=AfshinTaxi

GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Seeded automatically on container start if no user with this email exists yet
ADMIN_EMAIL=admin@afshintaxi.com
ADMIN_PASSWORD=change_me_to_a_strong_password
ADMIN_PHONE=+989000000000

# Origin allowed by CORS -- the public URL browsers will load the frontend from
FRONTEND_URL=https://yourdomain.com

# ---- Frontend (Nuxt) ----
# Same-origin through the nginx reverse proxy, so this is normally DOMAIN + /api
NUXT_PUBLIC_API_BASE=https://yourdomain.com/api

# Neshan Maps Platform -- https://platform.neshan.org/panel
NUXT_PUBLIC_NESHAN_WEB_KEY=your_neshan_web_api_key
NUXT_PUBLIC_NESHAN_API_KEY=your_neshan_service_api_key
