# Rendered by the nginx:alpine entrypoint (envsubst) into
# /etc/nginx/conf.d/default.conf on container start. Only ${DOMAIN} is
# substituted -- nginx's own $variables are left alone since they aren't
# shell environment variables.

upstream backend_upstream {
    server backend:3000;
}

upstream frontend_upstream {
    server frontend:3001;
}

server {
    listen 80;
    server_name ${DOMAIN};

    client_max_body_size 20M;

    # Uncomment once you have certs in place (see nginx/certs and README)
    # to redirect everything to HTTPS instead of serving plaintext.
    # return 301 https://$host$request_uri;

    location /api/ {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        proxy_pass http://frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

